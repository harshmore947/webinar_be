# ==========================================
# WEBINAR PLATFORM - ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and update with your actual values
# Never commit .env file to version control!

# ==========================================
# SERVER CONFIGURATION
# ==========================================
PORT=3001
NODE_ENV=development

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# MongoDB connection string
# For local: mongodb://localhost:27017/webinar_db
# For Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
MONGO_URL=mongodb://localhost:27017/webinar_db
MONGODB_URI=mongodb://localhost:27017/webinar_db

# ==========================================
# JWT AUTHENTICATION
# ==========================================
# Generate a strong random string for production
# Example: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRY=7d

# ==========================================
# CORS & CLIENT CONFIGURATION
# ==========================================
# Frontend application URL
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001

# ==========================================
# EMAIL CONFIGURATION (SMTP)
# ==========================================
# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Your Gmail credentials
# Important: Use App Password, not regular password
# Generate at: https://myaccount.google.com/apppasswords
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password

# Email sender information
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Change Networks

# Alternative: Resend API (if using Resend instead of SMTP)
RESEND_API_KEY=re_your_resend_api_key

# ==========================================
# CLOUDINARY CONFIGURATION
# ==========================================
# For image, video, and file uploads
# Sign up at: https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ==========================================
# STRIPE PAYMENT CONFIGURATION
# ==========================================
# Stripe API keys from: https://dashboard.stripe.com/apikeys
# Test keys start with sk_test_
# Live keys start with sk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ==========================================
# RAZORPAY PAYMENT (Optional - for India)
# ==========================================
# Get from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_SECRET=your_razorpay_secret

# ==========================================
# REDIS CONFIGURATION
# ==========================================
# For certificate queue and caching
# Leave password empty if no password is set
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ==========================================
# FEATURE FLAGS
# ==========================================
# Enable/disable certificate queue processing
CERT_USE_QUEUE=true

# ==========================================
# SETUP INSTRUCTIONS:
# ==========================================
# 1. MongoDB Setup:
#    - Local: Install MongoDB and use mongodb://localhost:27017/webinar_db
#    - Cloud: Create free cluster at https://www.mongodb.com/cloud/atlas
#
# 2. Gmail App Password:
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select app: Mail
#    - Select device: Other (Custom name)
#    - Generate and copy the 16-character password
#
# 3. Cloudinary Setup:
#    - Sign up at: https://cloudinary.com
#    - Get credentials from: https://cloudinary.com/console
#
# 4. Stripe Setup (for payments):
#    - Sign up at: https://stripe.com
#    - Get test keys from: https://dashboard.stripe.com/test/apikeys
#    - Setup webhook: https://dashboard.stripe.com/test/webhooks
#
# 5. Redis Setup (optional):
#    - Local: Install Redis or use Docker
#    - Cloud: Use Redis Labs or Upstash
#
# ==========================================
# PRODUCTION NOTES:
# ==========================================
# - Change NODE_ENV to 'production'
# - Use strong random JWT_SECRET
# - Use production database URL
# - Use live Stripe keys (sk_live_)
# - Enable SMTP_SECURE=true for port 465
# - Set proper CORS origins
# - Enable Redis password
# ==========================================
