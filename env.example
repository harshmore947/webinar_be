# ==================================
# Webinar Backend Environment Variables
# ==================================

# Server Configuration
NODE_ENV=production
PORT=3000

# ==================================
# Database Configuration
# ==================================

# MongoDB Connection String
# Local MongoDB (with authentication):
MONGODB_URI=mongodb://username:password@localhost:27017/webinar_db

# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/webinar_db?retryWrites=true&w=majority

# ==================================
# Redis Configuration
# ==================================

# Redis Connection URL
REDIS_URL=redis://localhost:6379

# Redis with password:
# REDIS_URL=redis://:your-password@localhost:6379

# Individual Redis settings (optional - use if not using REDIS_URL)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================================
# Authentication & Security
# ==================================

# JWT Secret Key (CHANGE THIS!)
JWT_SECRET=your-super-secret-jwt-key-min-32-characters-long
JWT_EXPIRY=7d

# ==================================
# CORS Configuration
# ==================================

# Frontend URL(s) - comma separated for multiple origins
CORS_ORIGIN=https://yourdomain.com,https://www.yourdomain.com

# ==================================
# Email Configuration
# ==================================

# Option 1: Resend (Recommended)
RESEND_API_KEY=re_your_resend_api_key_here
FROM_EMAIL=noreply@yourdomain.com

# Option 2: SMTP (Gmail, SendGrid, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-specific-password

# ==================================
# File Upload - Cloudinary
# ==================================

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ==================================
# Payment - Stripe
# ==================================

# Stripe Secret Key (use test key for development)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
# For production: sk_live_your_stripe_secret_key_here

# Stripe Webhook Secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Payment redirect URLs
STRIPE_SUCCESS_URL=https://yourdomain.com/webinars?payment_success=true
STRIPE_CANCEL_URL=https://yourdomain.com/webinars?payment_cancelled=true

# ==================================
# Application URLs
# ==================================

# Frontend URL
FRONTEND_URL=https://yourdomain.com

# Backend API URL
BACKEND_URL=https://api.yourdomain.com

# ==================================
# Logging Configuration
# ==================================

# Log level: error, warn, info, debug
LOG_LEVEL=info

# ==================================
# WebSocket Configuration (Optional)
# ==================================

# WebSocket path (default: /socket.io)
# WEBSOCKET_PATH=/socket.io

# ==================================
# Rate Limiting (Optional)
# ==================================

# Rate limit window in milliseconds (default: 15 minutes)
# RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 100)
# RATE_LIMIT_MAX=100

# ==================================
# Session Configuration (Optional)
# ==================================

# Session secret for cookie signing
# SESSION_SECRET=your-session-secret-key

# ==================================
# Additional Services (Optional)
# ==================================

# Bull Queue Dashboard
# BULL_BOARD_USERNAME=admin
# BULL_BOARD_PASSWORD=your-secure-password

# Analytics/Monitoring
# SENTRY_DSN=your-sentry-dsn-here

# ==================================
# Notes:
# ==================================
# 1. Copy this file to .env and fill in your actual values
# 2. NEVER commit .env file to version control
# 3. Use strong, unique passwords for production
# 4. Keep your secret keys secure
# 5. Use environment-specific values (dev, staging, production)

